{
 "format": "built.presets",
 "v": 2,
 "pack": {
  "id": "a8000621ef5697f7c93de35cea4d22ca",
  "name": "MEP penetrations",
  "version": "1.0.0",
  "author": {
   "name": "Built"
  },
  "licence": "GPL-3.0-or-later",
  "description": "Openings and fire collars sized from the penetrating service.",
  "units": {
   "length": "mm",
   "angle": "deg"
  },
  "requires": {
   "built": ">= 1.0",
   "features": [
    "junction.v1",
    "hole.v1",
    "block.v1",
    "fastener.v1",
    "weld.v1"
   ]
  }
 },
 "rows": [
  {
   "uid": "60cc1c9900a5e55d",
   "name": "Pipe through wall",
   "pack": "MEP penetrations",
   "primitive": "junction",
   "rev": 1,
   "values": {
    "meeting": "end_face",
    "params": [
     {
      "key": "clearance",
      "expr": "5",
      "name": "Radial clearance",
      "unit": "mm",
      "group": "Dimensions"
     },
     {
      "key": "opening_w",
      "expr": "joining.width + 2 * clearance",
      "name": "Opening width",
      "unit": "mm",
      "group": "Dimensions"
     },
     {
      "key": "opening_h",
      "expr": "joining.height + 2 * clearance",
      "name": "Opening height",
      "unit": "mm",
      "group": "Dimensions"
     },
     {
      "key": "rim",
      "expr": "8",
      "name": "Collar wall",
      "unit": "mm",
      "group": "Dimensions"
     },
     {
      "key": "depth",
      "expr": "40",
      "name": "Collar depth",
      "unit": "mm",
      "group": "Dimensions"
     }
    ],
    "contents": [
     {
      "key": "opening",
      "on": "main",
      "row": {
       "kind": "cut",
       "operation": "subtract",
       "cutter": {
        "hole": {
         "d": "opening_w",
         "depth": "through"
        }
       },
       "anchor": {
        "ref": "@joining.section"
       }
      }
     },
     {
      "key": "fire_collar",
      "part": {
       "sweep": {
        "profile": {
         "library": "basic/rail"
        }
       },
       "record": {
        "class": "IfcDiscreteAccessory",
        "name": "Fire collar"
       },
       "at": {
        "frame": "@joining.section"
       },
       "fields": {
        "thickness": "depth",
        "profile.params.width": "opening_w + 2 * rim",
        "profile.params.height": "opening_h + 2 * rim",
        "profile.params.web": "rim"
       }
      }
     }
    ],
    "roles": {
     "main": {
      "name": "Wall"
     },
     "joining": {
      "name": "Pipe"
     }
    },
    "rule": {
     "meeting": "end_face",
     "roles": {
      "main": {
       "class": [
        "IfcWall"
       ],
       "face": [
        "right"
       ]
      },
      "joining": {
       "profile": [
        {
         "family": "chs"
        }
       ]
      }
     }
    }
   },
   "locks": {},
   "record": {
    "class": "IfcElementAssembly"
   },
   "naming": "",
   "node": "",
   "provenance": {
    "created": "2026-11-28",
    "created_with": "Built",
    "derived_from": null
   },
