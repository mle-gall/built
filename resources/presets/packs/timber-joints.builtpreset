        "block": {
         "size": [
          "joining_w + 2",
          "main_w + 2",
          "joining_h / 2 + 1"
         ],
         "at": [
          "-joining_w / 2 - 1",
          "-main_w / 2 - 1",
          "-joining_h / 2 - 1"
         ]
        }
       },
       "anchor": {
        "ref": "@meet"
       }
      }
     },
     {
      "key": "dowel",
